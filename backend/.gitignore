# ==============================================================================
# Data Knowledge - Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Environment Variables & Secrets
.env
.env.*
*.env
config/firebase-service-account.json
**/firebase-service-account.json
*.pem
*.key
*.cert

# User Uploads & Media
uploads/*
!uploads/.gitkeep
uploads/**/*
!uploads/**/.gitkeep
invoices/*
certificates/*

# Video / Audio formats
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.mpg
*.mpeg
*.webm

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/